{
  "name": "alien-transporter-remaster",
  "productName": "Alien Transporter Remaster",
  "version": "0.1.0",
  "private": true,
  "description": "Alien Transporter Remaster",
  "author": "local",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "tsx tools/dev/dev.ts",
    "build": "electron-vite build",
    "tool:int-report": "tsx tools/int-report.ts",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && eslint . && vitest run",
    "test": "vitest",
    "test:e2e": "playwright test",
    "extract": "tsx tools/extract/index.ts",
    "viewer": "vite --config tools/viewer/vite.config.ts",
    "build:mac": "tsx tools/build/prepack.ts --mac && electron-vite build && electron-builder --mac --arm64",
    "build:win": "tsx tools/build/prepack.ts --win && electron-vite build && electron-builder --win --x64",
    "golden:update": "tsx tools/golden/update.ts",
    "golden:record": "tsx tools/golden/record.ts"
  },
  "dependencies": {
    "box2dweb": "2.1.0-b",
    "pixi.js": "8.21.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.2",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "fast-xml-parser": "5.11.2",
    "globals": "17.12.0",
    "maxrects-packer": "2.7.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  }
}
